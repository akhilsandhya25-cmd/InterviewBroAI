# =========================================================================
# InterviewBro AI - Environment Configuration Example
# =========================================================================

# --- BACKEND ENVIRONMENT VARIABLES (.env.local or server/.env.local) ---
# Port for Express API Server
PORT=5000

# Google Gemini API Key (Secret key used server-side only for question generation, follow-up challenge, and 5-pillar rubric evaluation)
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Gemini Model Name (defaults to gemini-2.5-flash with automatic fallback to gemini-2.0-flash / gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API Key (Optional, for neural voice synthesis)
# Get from: https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Supabase Service Role Key (Optional, for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here


# --- FRONTEND ENVIRONMENT VARIABLES (client/.env.local) ---
# Supabase Project URL & Anonymous Public Key (Free Tier: https://supabase.com)
# Get these in your Supabase project dashboard under Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
